// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== NextAuth.js Required Models =====
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ===== Assessment Center Models =====

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          String    // ADMIN, ASESOR, KLIEN, STAFF_KLIEN
  assessmentId  String?
  image         String?
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  assessment       Assessment?      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  uploadedDocuments Document[]      @relation("UploadedDocuments")
  uploadedResumes   Resume[]        @relation("UploadedResumes")
  uploadedDocs      Documentation[] @relation("UploadedDocs")
  uploadedAttendances Attendance[]  @relation("UploadedAttendances")
  accounts          Account[]
  sessions          Session[]
  certificates      Certificate[]   @relation("CreatedCertificates")
  trainings         Training[]      @relation("CreatedTrainings")
  reviewedRegistrants    TrainingRegistrant[] @relation("ReviewedRegistrants")
  updatedPaymentSettings PaymentSetting[]     @relation("UpdatedPaymentSettings")
  auditLogs              AuditLog[]           @relation("UserAuditLogs")

  @@index([assessmentId])
  @@map("users")
}

model Assessment {
  id          String   @id @default(cuid())
  name        String
  description String?
  clientName  String
  clientLogo  String?  // Path to logo file
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users          User[]
  documents      Document[]
  resumes        Resume[]
  resumeBatches  ResumeBatch[]
  documentations Documentation[]
  progresses     Progress[]
  echelons       Echelon[]
  attendances    Attendance[]

  @@map("assessments")
}

model Document {
  id           String   @id @default(cuid())
  title        String
  fileName     String
  filePath     String
  assessmentId String
  uploadedById String
  createdAt    DateTime @default(now())

  // Relations
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([uploadedById])
  @@map("documents")
}

model Resume {
  id            String   @id @default(cuid())
  title         String
  fileName      String
  filePath      String
  category      String   @default("UMUM") // UMUM, ESELON, INDIVIDU
  echelonId     String?  // Hanya diisi jika category = ESELON
  assessmentId  String
  uploadedById  String
  resumeBatchId String?
  createdAt     DateTime @default(now())

  // Relations
  assessment  Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  uploadedBy  User        @relation("UploadedResumes", fields: [uploadedById], references: [id], onDelete: Cascade)
  echelon     Echelon?    @relation(fields: [echelonId], references: [id], onDelete: SetNull)
  resumeBatch ResumeBatch? @relation(fields: [resumeBatchId], references: [id], onDelete: SetNull)

  @@index([assessmentId])
  @@index([uploadedById])
  @@index([echelonId])
  @@index([resumeBatchId])
  @@map("resumes")
}

model ResumeBatch {
  id           String   @id @default(cuid())
  name         String
  assessmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  resumes    Resume[]

  @@index([assessmentId])
  @@unique([assessmentId, name])
  @@map("resume_batches")
}

// Echelon untuk klasifikasi resume per eselon
model Echelon {
  id           String   @id @default(cuid())
  name         String   // "Eselon 2", "Eselon 3", etc
  order        Int      @default(0)
  assessmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  resumes    Resume[]

  @@index([assessmentId])
  @@map("echelons")
}

model Documentation {
  id           String   @id @default(cuid())
  title        String
  fileName     String
  filePath     String
  assessmentId String
  uploadedById String
  createdAt    DateTime @default(now())

  // Relations
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation("UploadedDocs", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([uploadedById])
  @@map("documentations")
}

// Progress tracking for assessment activities
model Progress {
  id           String   @id @default(cuid())
  activityName String   // Nama kegiatan
  percentage   Int      @default(0) // 0-100
  description  String?  // Deskripsi opsional
  order        Int      @default(0) // Urutan tampilan
  assessmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("progresses")
}

// Attendance files for assessment
model Attendance {
  id           String   @id @default(cuid())
  title        String   // Judul/nama file absensi
  fileName     String   // Nama file asli
  filePath     String   // Path file di server
  assessmentId String
  uploadedById String
  createdAt    DateTime @default(now())

  // Relations
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation("UploadedAttendances", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([uploadedById])
  @@map("attendances")
}

// ===== Insights/Article Models =====

model Article {
  id            String   @id @default(cuid())
  slug          String   @unique // URL-friendly identifier

  // Dual language content
  titleId       String   // Judul (Indonesia)
  titleEn       String   // Title (English)
  contentId     String   // Konten (Indonesia) - stored as HTML/Markdown
  contentEn     String   // Content (English) - stored as HTML/Markdown
  excerptId     String?  // Ringkasan singkat (Indonesia)
  excerptEn     String?  // Short excerpt (English)

  // Author info
  authorName    String   // Nama penulis
  authorPosition String? // Jabatan penulis (opsional)

  // Category: ARTICLE, WHITEPAPER, WEBINAR, CASE_STUDY, TEMPLATE
  category      String   @default("ARTICLE")

  // Image
  coverImage    String?  // Path to cover image
  imagePosition String   @default("TOP") // TOP, LEFT, RIGHT, CENTER

  // Status and visibility
  status        String   @default("DRAFT") // DRAFT, PUBLISHED
  isFeatured    Boolean  @default(false) // Tampilkan di homepage/featured section

  // Dates
  publishedAt   DateTime? // Tanggal publish
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([isFeatured])
  @@map("articles")
}

// ===== Certificate Models =====

model Certificate {
  id               String   @id @default(cuid())
  certCode         String   @unique // Contoh: LNA/06062026/PLTH-GRK/001
  type             String   @default("INSTANSI") // 'INDIVIDU' atau 'INSTANSI'
  verifyHash       String   @unique // Hash acak untuk URL verifikasi publik
  recipientName    String   // Nama Instansi (atau Nama Individu)
  programName      String   // Nama Program / Pelatihan
  description      String   // Deskripsi paragraf sertifikat
  maturityLevel    String?  // Contoh: Leader, Mature, Foundation (khusus Instansi)
  issuedDate       DateTime 
  qrCodeData       String?  // DataURL QR code
  pdfPath          String?  // Path file PDF di server
  template         String   @default("template-1") // 'template-1' | 'template-2' (+ template baru tanpa migrasi)
  templateData     String?  // JSON text untuk field khusus per-template, mis. {"signerRightName":"..."}
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relasi
  createdBy        User                     @relation("CreatedCertificates", fields: [createdById], references: [id])
  participants     CertificateParticipant[] // Relasi ke peserta instansi

  @@map("certificates")
}

model CertificateParticipant {
  id              String   @id @default(cuid())
  name            String   // Nama peserta
  certificateId   String
  createdAt       DateTime @default(now())

  // Relasi
  certificate     Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId])
  @@map("certificate_participants")
}

// ===== Info Pelatihan Models =====

model Training {
  id              String   @id @default(cuid())
  title           String
  location        String
  startDate       DateTime
  endDate         DateTime?
  price           String?  // teks bebas, contoh: "Gratis", "Rp 2.500.000"
  description     String
  imagePath       String?
  qrCodeData      String?  // DataURL QR code, redirect ke /info-pelatihan/[id]
  isActive        Boolean  @default(true) // nonaktifkan tanpa hapus data pendaftar
  requiresPayment Boolean  @default(false) // wajib upload bukti bayar saat daftar
  capacity        Int?     // kuota peserta, null = tidak terbatas. Registrant REJECTED tidak menghitung kuota.
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relasi
  createdBy   User                  @relation("CreatedTrainings", fields: [createdById], references: [id])
  registrants TrainingRegistrant[]

  @@index([createdById])
  @@index([startDate])
  @@map("trainings")
}

model TrainingRegistrant {
  id          String   @id @default(cuid())
  trainingId  String
  name        String
  email       String
  phone       String
  institution String?
  createdAt   DateTime @default(now())

  // Pembayaran — paymentStatus merekam kondisi SAAT ORANG INI DAFTAR, bukan
  // fungsi live dari Training.requiresPayment sekarang. Kalau admin toggle
  // requiresPayment training setelah ada registrant, row lama TIDAK diubah.
  paymentProofPath String?   // "/uploads/payment-proofs/xxx.jpg"
  paymentStatus    String    @default("NOT_REQUIRED") // NOT_REQUIRED | PENDING | APPROVED | REJECTED
  rejectionReason  String?
  reviewedAt       DateTime?
  reviewedById     String?

  // Relasi
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("ReviewedRegistrants", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([trainingId])
  @@index([reviewedById])
  @@map("training_registrants")
}

// ===== Reminder Kadaluarsa Sertifikat & Refreshment =====

model CertificationHolder {
  id                 String   @id @default(cuid())
  bsmrId             String   @unique // "ID BSMR" — unique biar re-import bisa upsert
  name               String
  institution        String
  level              String   // "Jenjang Terakhir"
  certificationName  String   // "Sertifikasi yang Diambil" — free text dulu
  email              String
  examDate           DateTime // "Tanggal Ujian"
  expiryDate         DateTime // "Masa Berakhir" — juga jadi trigger checkpoint ke-3/resertifikasi
  refreshment1Date   DateTime
  refreshment2Date   DateTime
  // Sengaja tidak ada refreshment3Date — checkpoint ke-3 pakai expiryDate langsung (selalu identik
  // di data sumber), simpan kolom terpisah cuma bikin resiko drift antar 2 kolom yang harusnya sama.

  refreshment1CompletedAt DateTime?
  refreshment2CompletedAt DateTime?
  recertCompletedAt       DateTime?

  refreshment1ReminderSentAt DateTime?
  refreshment2ReminderSentAt DateTime?
  recertReminderSentAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiryDate])
  @@index([refreshment1Date])
  @@index([refreshment2Date])
  @@map("certification_holders")
}

// Info rekening perusahaan untuk pembayaran manual — singleton (selalu 1 row, id tetap "singleton")
model PaymentSetting {
  id            String   @id @default("singleton")
  bankName      String   @default("")
  accountNumber String   @default("")
  accountHolder String   @default("")
  notes         String?
  updatedAt     DateTime @updatedAt
  updatedById   String?
  updatedBy     User?    @relation("UpdatedPaymentSettings", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("payment_settings")
}

// ===== Audit Log Model =====

model AuditLog {
  id         String   @id @default(cuid())
  entityType String   // "TRAINING", "PAYMENT_SETTING", "USER", "REGISTRANT"
  entityId   String
  action     String   // "CREATE", "UPDATE", "STATUS_CHANGE", "DELETE", "REVIEW_PAYMENT"
  summary    String
  changes    String?  // JSON diff string: { field: { old: val, new: val } }
  userId     String
  createdAt  DateTime @default(now())

  user       User     @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

